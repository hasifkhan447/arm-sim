<?xml version="1.0"?>
<sdf version="1.6">
<world name="basic_world">

<include>
  <uri>model://ground_plane</uri>
</include>

<include>
  <uri>model://sun</uri>
</include>
<model name="conveyor">
    <static>true</static>
    <pose>-5 -0.5 0.05 0 0 0</pose>
    <link name="belt">
      <collision name="collision">
        <geometry>
          <box><size>10 0.5 0.1</size></box>
        </geometry>
        <surface>
          <contact>
            <collide_bitmask>0x01</collide_bitmask>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>10 0.5 0.1</size></box>
        </geometry>
      </visual>
    </link>
    <plugin name="conveyor_belt_plugin" filename="libconveyer_plugin.so">
      <belt_velocity>0.05</belt_velocity>
      <belt_direction>-1 0 0</belt_direction>
    </plugin>
  </model>

<model name="cardboard_box">
  <pose>-0.3 -0.5 0.15 0 0 0</pose>
    <link name="bottom">
    <pose>0 0 -0.095 0 0 0</pose>
  <collision name="collision">
    <geometry>
      <box><size>0.2 0.2 0.01</size></box>
    </geometry>
    <surface>
      <friction>
        <ode>
          <mu>1.0</mu>
          <mu2>1.0</mu2>
        </ode>
      </friction>
      <bounce>
        <restitution_coefficient>0.1</restitution_coefficient>
        <threshold>0.01</threshold>
      </bounce>
      <contact>
        <ode>
          <kp>100000</kp>  <!-- Stiffness -->
          <kd>1</kd>        <!-- Damping -->
        </ode>
      </contact>
    </surface>
  </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>0.2 0.2 0.01</size>
        </box>
      </geometry>
      <material>
        <ambient>0.7 0.5 0.3 1</ambient>
        <diffuse>0.7 0.5 0.3 1</diffuse>
      </material>
    </visual>
    <inertial>
      <mass>0.15</mass>
      <inertia>
        <ixx>0.00050</ixx>
        <iyy>0.00050</iyy>
        <izz>0.00100</izz>
      </inertia>
    </inertial>


  </link>
  
    <link name="front_wall">
    <pose>0 0.095 0 0 0 0</pose>
    <collision name="collision">
