<?xml version="1.0"?>
<sdf version="1.6">
  <world name="basic_world">

    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Sun -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Cube -->
    <model name="cube">
      <pose>-0.1 -0.4 0 0 0 0</pose> <!-- x y z roll pitch yaw -->
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.07 0.07 0.07</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.07 0.07 0.07</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient> <!-- blue -->
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="conveyor">
      <static>true</static>
      <pose>-0.5 -0.5 0 0 0 0</pose> <!-- x y z roll pitch yaw -->
      <link name="belt">
        <collision name="collision">
          <geometry>
            <box><size>1 0.5 0.1</size></box>
          </geometry>
          <surface>
            <contact>
              <collide_bitmask>0x01</collide_bitmask>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1 0.5 0.1</size></box>
          </geometry>
        </visual>
      </link>
      <plugin name="conveyor_plugin" filename="libconveyer_plugin.so">
        <belt_velocity>0.3</belt_velocity> <!-- m/s -->
        <belt_direction>-1 0 0</belt_direction> <!-- X axis -->
      </plugin>
    </model>









  </world>
</sdf>
