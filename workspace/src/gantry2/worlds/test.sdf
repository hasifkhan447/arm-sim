      <mass>0.08</mass>
      <inertia>
        <ixx>0.00024</ixx>
        <iyy>0.00003</iyy>
        <izz>0.00024</izz>
      </inertia>
    </inertial>
  </link>
  
    <joint name="front_wall_joint" type="fixed">
    <parent>bottom</parent>
    <child>front_wall</child>
  </joint>
  
    <link name="flap_2">
    <pose>0.0 -0.15 0.095 0 0 0</pose>     <collision name="collision">
      <geometry>
        <box>
          <size>0.2 0.1 0.005</size>
        </box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>0.2 0.1 0.005</size>
        </box>
      </geometry>
      <material>
        <ambient>0.7 0.5 0.3 1</ambient>
        <diffuse>0.7 0.5 0.3 1</diffuse>
      </material>
    </visual>
    <inertial>
      <mass>0.04</mass>
      <inertia>
        <ixx>0.000003</ixx>
        <iyy>0.000007</iyy>
        <izz>0.000007</izz>
      </inertia>
    </inertial>
  </link>
  
  <joint name="flap_2_joint" type="revolute">
    <parent>back_wall</parent>
    <child>flap_2</child>
    <pose>0.0 0.05 0 0 0 0</pose>     <axis>
      <xyz>1 0 0</xyz>       <limit>
        <lower>-3.1416</lower>
        <upper>1.5</upper>
      </limit>
      <dynamics>
        <damping>0.0025</damping>         <friction>0.0025</friction>
      </dynamics>
    </axis>
  </joint>
  
  <joint name="back_wall_joint" type="fixed">
    <parent>bottom</parent>
    <child>back_wall</child>
  </joint>
  
  <joint name="left_wall_joint" type="fixed">
    <parent>bottom</parent>
    <child>left_wall</child>
  </joint>
  
  <joint name="right_wall_joint" type="fixed">
    <parent>bottom</parent>
    <child>right_wall</child>
  </joint>
  
    <link name="flap_1">
    <pose>0.0 0.15 0.095 0 0 0</pose>     <collision name="collision">
      <geometry>
        <box>
