        <iyy>0.000007</iyy>
        <izz>0.000007</izz>
      </inertia>
    </inertial>
  </link>
  
  <joint name="flap_1_joint" type="revolute">
    <parent>front_wall</parent>
    <child>flap_1</child>
    <pose>0.0 -0.05 0 0.5 0 0</pose>     <axis>
      <xyz>1 0 0</xyz>       <limit>
        <lower>-1.5</lower>         <upper>3.1416</upper>            </limit>
      <dynamics>
        <damping>0.002</damping>
        <friction>0.002</friction>
      </dynamics>
    </axis>
  </joint>
  

  <link name="flap_3">
    <pose>-0.15 0 0.095 0 0 0</pose>
    <collision name="collision">
      <geometry>
        <box>
          <size>0.1 0.19 0.005</size>
        </box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>0.1 0.19 0.005</size>
        </box>
      </geometry>
      <material>
        <ambient>0.7 0.5 0.3 1</ambient>
        <diffuse>0.7 0.5 0.3 1</diffuse>
      </material>
    </visual>
    <inertial>
      <mass>0.04</mass>
      <inertia>
        <ixx>0.000005</ixx>
        <iyy>0.000003</iyy>
        <izz>0.000006</izz>
      </inertia>
    </inertial>
  </link>

  <joint name="flap_3_joint" type="revolute">
    <parent>left_wall</parent>
    <child>flap_3</child>
    <pose>0.05 0 0 0 0 0</pose>
    <axis>
      <xyz>0 1 0</xyz>
      <limit>
        <lower>0.5</lower>
        <upper>3.1416</upper>
      </limit>
      <dynamics>
        <damping>0.0005</damping>
        <friction>0.0005</friction>
      </dynamics>
    </axis>
    <initial_position>0.6</initial_position>
  </joint>

  <link name="flap_4">
    <pose>0.15 0 0.095 0 0 0</pose>
    <collision name="collision">
      <geometry>
        <box>
          <size>0.1 0.19 0.005</size>
        </box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>0.1 0.19 0.005</size>
        </box>
      </geometry>
      <material>
        <ambient>0.7 0.5 0.3 1</ambient>
        <diffuse>0.7 0.5 0.3 1</diffuse>
      </material>
    </visual>
    <inertial>
      <mass>0.01</mass>
      <inertia>
        <ixx>0.00001</ixx>
        <iyy>0.00001</iyy>
        <izz>0.00001</izz>
      </inertia>
    </inertial>
  </link>

  <joint name="flap_4_joint" type="revolute">
    <parent>right_wall</parent>
    <child>flap_4</child>
    <pose>-0.05 0 0 0 0 0</pose>
    <axis>
      <xyz>0 1 0</xyz>
      <limit>
        <lower>-3.1416</lower>
        <upper>-0.5</upper>
      </limit>
      <dynamics>
        <damping>0.0005</damping>
        <friction>0.0005</friction>
      </dynamics>
    </axis>
    <initial_position>-0.6</initial_position>
  </joint>
</model>

<model name="microwave">
  <pose>-0.3 -0.4 0.2 0 0 0</pose>
  <link name="microwave_link">
    <collision name="collision">
      <geometry>
        <box>
          <size>0.1 0.1 0.1</size>
        </box>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>0.8</mu>
            <mu2>0.8</mu2>
          </ode>
        </friction>
        <bounce>
          <restitution_coefficient>0.4</restitution_coefficient>
          <threshold>0.0</threshold>
        </bounce>
      </surface>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>0.1 0.1 0.1</size>
        </box>
      </geometry>
      <material>
        <ambient>1 1 1 1</ambient>
        <diffuse>1 1 1 1</diffuse>
        <specular>1 1 1 1</specular>
      </material>
    </visual>
    <inertial>
      <mass>0.5</mass>
      <inertia>
        <ixx>0.00083</ixx>
        <iyy>0.00083</iyy>
        <izz>0.00083</izz>
      </inertia>
    </inertial>

  </link>
</model>
	<plugin name="gazebo_link_attacher" filename="libgazebo_link_attacher.so"><model_name>gantry</model_name><attach_service_name>ATTACHLINK</attach_service_name><detach_service_name>DETACHLINK</detach_service_name></plugin>


  

  <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
    <ros>
      <namespace>/gazebo</namespace>
    </ros>

    <update_rate>1.0</update_rate>
  </plugin>


</world>
</sdf>
