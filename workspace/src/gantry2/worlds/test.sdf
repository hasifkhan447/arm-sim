        <ixx>0.00024</ixx>
        <iyy>0.00003</iyy>
        <izz>0.00024</izz>
      </inertia>
    </inertial>
  </link>
  
    <link name="right_wall">
    <pose>0.095 0 0 0 0 0</pose>
    <collision name="collision">
      <geometry>
        <box>
          <size>0.01 0.19 0.19</size>
        </box>
