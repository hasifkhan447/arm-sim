<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rectangular_gantry">


  <xacro:property name="length_bar" value="1" />    <!-- travel along X (m) -->
  <xacro:property name="thickness_bar" value="0.2" />    <!-- travel along X (m) -->
  <xacro:property name="width_bar" value="0.2" />    <!-- travel along X (m) -->
  <xacro:property name="mass_bar" value="1" />    <!-- travel along X (m) -->

  <xacro:macro name="bar" params="name parent xyz rpy">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="${length_bar} ${width_bar} ${thickness_bar}" />
        </geometry>
        <material name="gray">
          <color rgba="0.6 0.6 0.6 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="${length_bar} ${width_bar} ${thickness_bar}" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="${mass_bar}" />
        <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0" />
      </inertial>
    </link>

    <joint name="${parent}_to_${name}" type="fixed">
      <parent link="${parent}" />
      <child link="${name}" />
      <origin xyz="${xyz}" rpy="${rpy}" />
    </joint>
  </xacro:macro>


  <link name="map" />
  <xacro:bar name="leg1" parent="map" xyz="0 0 ${length_bar/2}" rpy="0 -${pi/2} 0" />
  <xacro:bar name="leg2" parent="map" xyz="-${length_bar} 0 ${length_bar/2}" rpy="0 -${pi/2} 0" />

  <xacro:bar name="layer1" parent="map" xyz="-${length_bar/2} 0 ${length_bar}"
    rpy="0 0 0" />
  <!-- This is from 1 and 2 -->

  <xacro:bar name="layer2" parent="map" xyz="-${length_bar} -${length_bar/2} ${length_bar}"
    rpy="0 0 -${pi/2}" />
  <!-- This is from 2 and 3  -->

  <xacro:bar name="leg3" parent="map" xyz="-${length_bar} -${length_bar} ${length_bar/2}"
    rpy="0 -${pi/2} 0" />

  <xacro:bar name="layer3" parent="map" xyz="0 -${length_bar/2} ${length_bar}"
    rpy="0 0 -${pi/2}" />

  <xacro:bar name="leg4" parent="map" xyz="0 -${length_bar} ${length_bar/2} " rpy="0 -${pi/2} 0" />

  <xacro:bar name="layer4" parent="map" xyz="-${length_bar/2} -${length_bar} ${length_bar}"
    rpy="0 0 0" />
  <!-- This is from 3 and 4  -->


</robot>
