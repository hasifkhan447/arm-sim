<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="eemount">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder length="0.01" radius="0.05" />
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder length="0.01" radius="0.05" />
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="${mass_bar}" />
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0" />
    </inertial>
  </link>

  <joint name="zaxis_to_eemount" type="revolute">
    <parent link="zaxis" />
    <child link="eemount" />
    <origin xyz="-${length_bar/2 + width_bar} 0 0" rpy="0 ${pi/2} 0" />
    <axis xyz="0 0 1" />
    <limit lower="-1.57" upper="1.57" effort="5" velocity="1" />
  </joint>

  <!-- Left finger -->
  <link name="left_finger">
    <visual>
      <origin xyz="0 0.05 0" rpy="0 0 0" />
      <geometry>
        <box size="0.02 0.1 0.02" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0.05 0" rpy="0 0 0" />
      <geometry>
        <box size="0.02 0.1 0.02" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05" />
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>


  <!-- Right finger -->
  <link name="right_finger">
    <visual>
      <origin xyz="0 -0.05 0" rpy="0 0 0" />
      <geometry>
        <box size="0.02 0.1 0.02" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 -0.05 0" rpy="0 0 0" />
      <geometry>
        <box size="0.02 0.1 0.02" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05" />
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>


  <joint name="gripper_left_joint" type="prismatic">
    <parent link="eemount" />
    <child link="left_finger" />
    <origin xyz="0 0.05 -0.12" rpy="${pi/2} 0 0" />
    <axis xyz="0 0 1" /> <!-- slides along +Y -->
    <limit lower="0.0" upper="0.04" effort="10" velocity="0.1" />
  </joint>


  <joint name="gripper_right_joint" type="prismatic">
    <parent link="eemount" />
    <child link="right_finger" />
    <origin xyz="0 -0.05 -0.02" rpy="${pi/2} 0 0" />
    <axis xyz="0 0 -1" /> <!-- slides along -Y -->
    <limit lower="0.0" upper="0.04" effort="10" velocity="0.1" />
    <!-- <mimic joint="gripper_left_joint" multiplier="-1" offset="0" /> -->
  </joint>


</robot>
