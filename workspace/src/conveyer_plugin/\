#include <gazebo/gazebo.hh>
#include <gazebo/physics/physics.hh>
#include <gazebo/common/common.hh>
#include <ignition/math/Vector3.hh>
#include <string>

namespace gazebo
{
  class ConveyorPlugin : public ModelPlugin
  {
    physics::ModelPtr model;
    physics::WorldPtr world;
    event::ConnectionPtr updateConnection;
    ignition::math::Vector3d direction;
    double velocity;

  public:
    void Load(physics::ModelPtr _parent, sdf::ElementPtr _sdf) override
    {
      model = _parent;
      world = model->GetWorld();

      // Parse params
      velocity = _sdf->HasElement("belt_velocity") ?
                 _sdf->Get<double>("belt_velocity") : 0.2;

      if (_sdf->HasElement("belt_direction"))
        direction = _sdf->Get<ignition::math::Vector3d>("belt_direction").Normalize();
      else
        direction = ignition::math::Vector3d(1, 0, 0); // default x-axis

      gzdbg << "[ConveyorPlugin] Loaded with velocity=" << velocity
            << " direction=" << direction << std::endl;

      // Connect update
      updateConnection = event::Events::ConnectWorldUpdateBegin(
          std::bind(&ConveyorPlugin::OnUpdate, this));
    }

    void OnUpdate()
    {
      for (auto &m : world->Models())
      {
        if (m == model) continue; // skip the conveyor itself

        std::string modelName = m->GetName();

        // ✅ Only apply to cubes
        if (modelName.find("cube") != 0) // starts with "cube"
          continue;

        auto link = m->GetLink();
        if (!link) continue;

        // Proximity check: is the cube near conveyor surface?
        auto pos = link->WorldPose().Pos();
        auto beltPos = model->WorldPose().Pos();

        if (fabs(pos.Z() - beltPos.Z()) < 0.2 && fabs(pos.X() - beltPos.X() < 0.5)) // near surface
        {
          ignition::math::Vector3d vel = direction * velocity;
          link->SetLinearVel(vel);
        }
      }
    }
  };

  GZ_REGISTER_MODEL_PLUGIN(ConveyorPlugin)
}

